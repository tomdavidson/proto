# Repo toolchain only (bun, taplo, dprint, shfmt) — not a plugin registry. 
# Do not add new plugins here.

bun    = "1.2.13"
dprint = "0.50.0"
shfmt  = "3.13.0"
taplo  = "0.10.0"
jsonschema = "0.37.1"
shellcheck = "0.11.0"

[plugins.tools]
dprint = "source:plugins/dprint.toml"
shfmt  = "source:plugins/shfmt.toml"
taplo  = "source:plugins/taplo.toml"
jsonschema = "source:plugins/jsonschema.toml"
shellcheck = "source:plugins/shellcheck.toml"
